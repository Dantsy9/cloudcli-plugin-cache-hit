# ── Build output ─────────────────────────────────────────────────────────────
# The CloudCLI host runs `npm run build` itself on install/update, so the
# compiled bundle is never committed.
dist/
*.tsbuildinfo

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ── Local secrets / overrides ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Test scratch ─────────────────────────────────────────────────────────────
# The suites create their fixtures under the OS temp dir, never in the repo;
# this is belt-and-braces in case a run is interrupted mid-copy.
test/.tmp/
coverage/
